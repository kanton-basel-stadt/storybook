  "license": "GPL-v3",
  "homepage": "https://kanton-basel-stadt.github.io/storybook",
  "main": "index.js",
  "scripts": {
    "test": "test-storybook",
    "storybook": "FONT_BASE_DIR=\"\" npm run build-css && npm run twc-build && storybook dev -p 6006",
    "build-storybook": "FONT_BASE_DIR=\"/storybook/built-css\" npm run build-css && npm run twc-build && storybook build",
    "build": "npm run build-storybook",
    "start": "npm run storybook",
    "dev": "npm run storybook",
    "twc-build": "./node_modules/.bin/tailwind-config-viewer -c ./node_modules/@kanton-basel-stadt/designsystem/dist/configs/tailwind.config.js export ./static/tailwind_config_viewer",
    "lint": "./node_modules/.bin/eslint .",
    "lint:fix": "./node_modules/.bin/eslint . --fix",
    "build-css": "./node_modules/.bin/vite build"
  },
  "keywords": [
    "storybook",
    "basel-stadt",
    "designsystem",
    "switzerland"
  ],
  "type": "module",
  "devDependencies": {
