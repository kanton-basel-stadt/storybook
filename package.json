{
  "name": "@kanton-basel-stadt/storybook",
  "version": "1.0.0",
  "description": "The Storybook instance of the DDS.",
  "author": "Kanton Basel-Stadt",
  "license": "GPL-v3",
  "homepage": "https://kanton-basel-stadt.github.io/storybook",
  "main": "index.js",
  "scripts": {
    "test": "test-storybook",
    "storybook": "FONT_BASE_DIR=\"\" npm run build-css && npm run twc-build && storybook dev -p 6006",
    "build-storybook": "FONT_BASE_DIR=\"/storybook/built-css\" npm run build-css && npm run twc-build && storybook build",
    "build": "npm run build-storybook",
    "start": "npm run storybook",
    "dev": "npm run storybook",
    "twc-build": "tailwind-config-viewer -c ./node_modules/@kanton-basel-stadt/designsystem/dist/configs/tailwind.config.js export ./static/tailwind_config_viewer",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build-css": "vite build"
  },
  "keywords": [
    "storybook",
    "basel-stadt",
    "designsystem",
    "switzerland"
  ],
  "type": "module",
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-links": "^10.4.2",
    "@storybook/test-runner": "^0.24.4",
    "@storybook/web-components-vite": "^10.4.2",
    "@typescript-eslint/parser": "^8.19.1",
    "@whitespace/storybook-addon-html": "^9.0.0",
    "axe-playwright": "^2.0.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-lit": "^1.15.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-storybook": "^10.4.2",
    "html-validate": "^9.1.3",
    "lit": "^3.2.0",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "react-syntax-highlighter": "^15.5.0",
    "storybook": "^10.4.2",
    "tailwind-config-viewer": "^2.0.4",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.2.6"
  },
  "dependencies": {
    "@kanton-basel-stadt/designsystem": "^1.2.1",
    "@storybook/addon-docs": "^10.4.2",
    "lorem-ipsum": "^2.0.8",
    "marked": "^15.0.3",
    "marked-highlight": "^2.2.1",
    "react": "^19.0.0",
    "remark-gfm": "^4.0.0",
    "slugify": "^1.6.6",
    "tailwindcss": "^3.4.13"
  }
}
