{
  "name": "@kanton-basel-stadt/storybook",
  "version": "1.0.0",
  "description": "The Storybook instance of the DDS.",
  "author": "Kanton Basel-Stadt",
  "license": "GPL-v3",
  "homepage": "https://kanton-basel-stadt.github.io/storybook",
  "main": "index.js",
  "scripts": {
    "test": "test-storybook",
    "storybook": "npm run tw-build && npm run twc-build && storybook dev -p 6006",
    "build-storybook": "npm run tw-build && npm run twc-build && storybook build",
    "start": "npm run storybook",
    "twc-build": "./node_modules/.bin/tailwind-config-viewer -c ./node_modules/@kanton-basel-stadt/designsystem/dist/configs/tailwind.config.js export ./static/tailwind_config_viewer",
    "tw-build": "./node_modules/.bin/tailwindcss -i ./static/css/storybook.css -o ./static/css/storybook-built.css -c ./node_modules/\\@kanton-basel-stadt/designsystem/dist/configs/tailwind.config.js",
    "lint": "./node_modules/.bin/eslint .",
    "lint:fix": "./node_modules/.bin/eslint . --fix"
  },
  "keywords": [
    "storybook",
    "basel-stadt",
    "designsystem",
    "switzerland"
  ],
  "type": "module",
  "devDependencies": {
    "@storybook/addon-a11y": "^8.4.6",
    "@storybook/addon-designs": "^8.0.3",
    "@storybook/addon-essentials": "^8.4.6",
    "@storybook/addon-links": "^8.4.6",
    "@storybook/blocks": "^8.4.6",
    "@storybook/manager-api": "^8.4.6",
    "@storybook/test": "^8.4.6",
    "@storybook/test-runner": "^0.21.0",
    "@storybook/theming": "^8.4.6",
    "@storybook/web-components": "^8.4.6",
    "@storybook/web-components-vite": "^8.4.6",
    "@typescript-eslint/parser": "^8.19.1",
    "@whitespace/storybook-addon-html": "^6.1.1",
    "axe-playwright": "^2.0.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-lit": "^1.15.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-storybook": "^0.11.1",
    "html-validate": "^9.1.3",
    "lit": "^3.2.0",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "storybook": "^8.4.6",
    "tailwind-config-viewer": "^2.0.4",
    "typescript-eslint": "^8.18.1"
  },
  "dependencies": {
    "@kanton-basel-stadt/designsystem": "^1.0.0",
    "@storybook/addon-backgrounds": "^8.4.7",
    "@storybook/addon-controls": "^8.4.7",
    "@storybook/addon-docs": "^8.4.7",
    "@storybook/addon-measure": "^8.4.7",
    "@storybook/addon-outline": "^8.4.7",
    "@storybook/addon-toolbars": "^8.4.7",
    "@storybook/addon-viewport": "^8.4.7",
    "lorem-ipsum": "^2.0.8",
    "marked": "^15.0.3",
    "marked-highlight": "^2.2.1",
    "react": "^18.0.0",
    "remark-gfm": "^4.0.0",
    "slugify": "^1.6.6",
    "tailwindcss": "^3.4.13"
  }
}
