{
  "name": "@kanton-basel-stadt/storybook",
  "version": "1.0.0",
  "description": "The Storybook instance of the DDS.",
  "author": "Kanton Basel-Stadt",
  "license": "GPL-v3",
  "homepage": "https://kanton-basel-stadt.github.io/storybook",
  "main": "index.js",
  "scripts": {
    "test": "vitest --project=storybook --run",
    "storybook": "FONT_BASE_DIR=\"\" npm run build-css && npm run twc-build && storybook dev -p 6006",
    "build-storybook": "FONT_BASE_DIR=\"/storybook/built-css\" npm run build-css && npm run twc-build && storybook build",
    "build": "npm run build-storybook",
    "start": "npm run storybook",
    "dev": "npm run storybook",
    "twc-build": "tailwind-config-viewer -c ./node_modules/@kanton-basel-stadt/designsystem/dist/configs/tailwind.config.js export ./static/tailwind_config_viewer",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build-css": "vite build"
  },
  "keywords": [
    "storybook",
    "basel-stadt",
    "designsystem",
    "switzerland"
  ],
  "type": "module",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@whitespace/storybook-addon-html": "^9.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.5.10",
    "html-validate": "^9.7.1",
    "lit": "^3.3.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-syntax-highlighter": "^16.1.1",
    "storybook": "^10.5.10",
    "tailwind-config-viewer": "^2.0.4",
    "typescript": "",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@kanton-basel-stadt/designsystem": "^2.0.0-beta.3",
    "@storybook/addon-docs": "^10.5.10",
    "lorem-ipsum": "^2.0.10",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.9",
    "tailwindcss": "^3.4.19"
  }
}
